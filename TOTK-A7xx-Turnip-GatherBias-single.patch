+/* Experimental TOTK gather rounding workaround for Adreno 7xx.
+ * Bias normalized 2D gathers by 1/512 texel, without affecting other tex ops.
+ */
+static bool
+ir3_nir_gather_bias_cb(struct nir_builder *b, nir_tex_instr *tex, void *data)
+{
+   if (tex->op != nir_texop_tg4 ||
+       tex->sampler_dim != GLSL_SAMPLER_DIM_2D ||
+       tex->is_array || tex->is_shadow || tex->coord_components != 2)
+      return false;
+
+   int coord_idx = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   if (coord_idx < 0)
+      return false;
+
+   nir_def *coord = tex->src[coord_idx].src.ssa;
+   if (coord->bit_size != 32)
+      return false;
+
+   b->cursor = nir_before_instr(&tex->instr);
+   nir_def *size = nir_build_texture_query(b, tex, nir_texop_txs, 2,
+                                           nir_type_uint32, false, true);
+   nir_def *size_f = nir_u2fN(b, size, 32);
+   nir_def *inv_size = nir_frcp(b, size_f);
+   nir_def *bias = nir_fmul(b, nir_imm_vec2(b, 1.0f / 512.0f,
+                                              1.0f / 512.0f), inv_size);
+   nir_def *biased_coord = nir_fadd(b, coord, bias);
+   nir_src_rewrite(&tex->src[coord_idx].src, biased_coord);
+   return true;
+}
+
+static bool
+ir3_nir_gather_bias_workaround(nir_shader *shader)
+{
+   return nir_shader_tex_pass(shader, ir3_nir_gather_bias_cb,
+                             nir_metadata_control_flow, NULL);
+}
